{
  "name": "region-to-skylines",
  "version": "0.5.0",
  "description": "Real terrain to a ready-to-play Cities: Skylines 1 map (or a heightmap), from the command line or the browser.",
  "license": "MIT",
  "type": "module",
  "homepage": "https://region-to-skylines.vercel.app",
  "repository": { "type": "git", "url": "git+https://github.com/frontierkodiak/region-to-skylines.git" },
  "bin": { "region-to-skylines": "cli.mjs" },
  "files": [
    "cli.mjs", "terrain.js", "inputs.js", "mapgen.js",
    "tools/map-factory/generate.py", "tools/map-factory/region.py", "tools/map-factory/prepare.py", "tools/map-factory/surface_water.py", "tools/map-factory/crp.py", "tools/map-factory/template.py", "tools/map-factory/map_metadata.py",
    "tools/map-factory/paint.py", "tools/map-factory/resources.py", "tools/map-factory/landcover.py", "tools/map-factory/evidence.py", "tools/map-factory/web.py", "tools/map-factory/templates/native-corridors.crp", "tools/map-factory/templates/native-corridors.json"
  ],
  "scripts": {
    "test": "node --test test/unit.test.mjs",
    "test:fixtures": "node --test --test-concurrency=1 test/fixtures.test.mjs"
  },
  "engines": { "node": ">=20.3" },
  "dependencies": {
    "@mapbox/vector-tile": "2.0.3",
    "geotiff": "2.1.3",
    "pbf": "4.0.1",
    "pyodide": "314.0.7"
  }
}
