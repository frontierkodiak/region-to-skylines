{
  "buildCommand": "node build.mjs",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/worldcover/:tile(ESA_WorldCover_10m_2021_v200_[NS]\\d{2}[EW]\\d{3}_Map\\.tif)",
      "destination": "https://esa-worldcover.s3.eu-central-1.amazonaws.com/v200/2021/map/:tile"
    },
    {
      "source": "/canopy/:tile([0-3]{10}\\.tif)",
      "destination": "https://dataforgood-fb-data.s3.us-east-1.amazonaws.com/forests/v2/global/dinov3_global_chm_v2_ml3/chm/:tile"
    },
    {
      "source": "/forest-types.tif",
      "destination": "https://zenodo.org/api/records/3939050/files/PROBAV_LC100_global_v3.0.1_2019-nrt_Forest-Type-layer_EPSG-4326.tif/content"
    }
  ],
  "headers": [
    {
      "source": "/worldcover/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
