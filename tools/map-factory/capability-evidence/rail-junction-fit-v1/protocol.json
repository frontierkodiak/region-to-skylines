  "hypotheses": {
    "junction_kinds": {
      "continuation": "greedy disjoint straightest-first pairing of incident Train segments; equal-turn candidates are alternatives",
      "turn": "every incident Train segment pair whose turn angle is at most the threshold"
    },
    "length": "sum of segment chords, a lower bound on the native curve length, never called native cost",
    "max_alternatives": 32,
    "max_length": 100000.0,
    "measures": {
      "chord": "turn angle from the chord between node positions (the accepted v2 geometry)",
      "tangent": "turn angle from the export's authored endpoint directions"
    },
    "override_direction_limit": "read and recorded for every segment; never used by a rule, because its game semantics are unproven and every observed value is 0",
    "pairings": {
      "any_lane": "every Train lane continues onto every Train lane of the connected segment",
      "orientation_index": "Train lane ordinal i continues onto ordinal i at a mixed node and n-i-1 at a same-sided node (the accepted v2 lateral-side rule)"
    },
    "tangent_convention": "the stored vector points from the named end into the segment, so start_direction is the outgoing heading at the start node and end_direction at the end node; proved against the export's own node positions",
    "tangent_provenance": "export-derived and not native-attested: the accepted networks.json snapshot emits no endpoint tangents",
    "threshold_tolerance_degrees": 1e-06,
    "thresholds_degrees": [
      0,
      5,
      10,
      15,
      20,
      30,
      45,
      60,
      90,
      120,
      150,
      180
    ],
    "tie_tolerance_degrees": 1e-06,
    "uturn": "forbidden"
  },
